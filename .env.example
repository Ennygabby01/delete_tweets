# Run make setup to generate the private .env and its encryption key.
# Register the printed callback in your X OAuth 2.0 app settings. Local default:
# http://127.0.0.1:8000/v1/auth/callback
APP_ORIGIN=http://127.0.0.1:8000
# Public hosting: APP_ORIGIN=https://delete.example.com (no path or trailing slash).
# Backend stays on loopback behind nginx; HTTPS mode never changes a busy port.
APP_BIND_HOST=127.0.0.1
# Optional locally; defaults to APP_ORIGIN's port or 8000. Set explicitly on servers.
# APP_BIND_PORT=8000
# Required for HTTPS: exact proxy IPs, comma-separated; never * or an IP range.
# TRUSTED_PROXY_IPS=127.0.0.1
# Required for HTTPS: your numeric X account ID, not your username or client ID.
# X_OWNER_ID=
APP_ENCRYPTION_KEY=
X_CLIENT_ID=
# Required for a confidential Web App; leave empty for a public/native client.
X_CLIENT_SECRET=
# DATA_DIR defaults to this project's ignored data/ directory.
# DATA_DIR=/absolute/private/path
SESSION_IDLE_SECONDS=1800
SESSION_LIFETIME_SECONDS=43200
MAX_ARCHIVE_BYTES=67108864
MAX_JSON_BYTES=262144
BODY_TIMEOUT_SECONDS=30
MAX_HEADER_BYTES=16384
MAX_HEADER_COUNT=100
# Conservative documented fallback; actual response headers take priority.
X_DELETE_FALLBACK_LIMIT=50
X_DELETE_WINDOW_SECONDS=900
MAX_POSTS_PER_RUN=50
# Total distinct posts allowed in one scheduled runner snapshot.
MAX_SCHEDULE_POSTS=5000
X_REQUEST_TIMEOUT_SECONDS=15
MAX_X_RESPONSE_BYTES=262144
WORKER_INTERVAL_SECONDS=1
MAX_CONNECTIONS=64
AUTH_REQUESTS_PER_10_MIN=60
READ_REQUESTS_PER_MINUTE=600
WRITE_REQUESTS_PER_MINUTE=60
ARCHIVE_IMPORTS_PER_10_MIN=3

# Legacy-client automatic sync is disabled. Current UI sync is manual only.
# X API reads may consume credits.
X_AUTO_SYNC=false
X_SYNC_PAGE_SIZE=100
X_SYNC_MIN_INTERVAL_SECONDS=2
X_SYNC_RETRY_SECONDS=60
